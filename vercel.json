{
  "name": "studyos",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/routines",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/cleanup-media",
      "schedule": "0 1 * * *"
    }
  ]
}
